    "emerald":       { "hex": "#1F5B4C", "rgb": [31, 91, 76],    "cmyk": [66, 0, 16, 64], "role": "Labels, eyebrows" },
    "slate":         { "hex": "#4B5468", "rgb": [75, 84, 104],   "cmyk": [28, 19, 0, 59],  "role": "Body text" },
    "goldAntique":   { "hex": "#9C7519", "rgb": [156, 117, 25],  "cmyk": [0, 25, 84, 39],  "role": "Advisory in the logo, numerals" },
    "bronze":        { "hex": "#7A5E14", "rgb": [122, 94, 20],   "cmyk": [0, 23, 84, 52],  "role": "Small gold-toned text" },
    "stone":         { "hex": "#5F5A4D", "rgb": [95, 90, 77],    "cmyk": [0, 5, 19, 63],   "role": "Captions, metadata" },
    "parchment":     { "hex": "#D9CDB0", "rgb": [217, 205, 176], "cmyk": [0, 6, 19, 15],   "role": "Rules and borders" },
    "mist":          { "hex": "#E4DAC0", "rgb": [228, 218, 192], "cmyk": [0, 4, 16, 11],   "role": "Soft rules" },
