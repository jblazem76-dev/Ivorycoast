  "fonts": {
    "display": { "family": "Fraunces", "weights": [400, 500, 600], "italic": [400, 500], "opticalSize": 36, "license": "SIL Open Font License" },
    "body":    { "family": "IBM Plex Sans", "weights": [400, 500, 600], "license": "SIL Open Font License" },
    "mono":    { "family": "IBM Plex Mono", "weights": [400, 500], "license": "SIL Open Font License" }
  },
  "logo": {
    "clearSpace": "X = cap height of the I in IvoryCoast (lockups); X = 1/4 crest width (crest alone)",
